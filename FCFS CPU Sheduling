
n = int(input("Enter number of processes: "))

bt = []
wt = []
tat = []

for i in range(n):
    time = int(input(f"Enter burst time of P{i+1}: "))
    bt.append(time)

wt.append(0)

for i in range(1, n):
    wt.append(wt[i-1] + bt[i-1])

for i in range(n):
    tat.append(wt[i] + bt[i])

print("\nProcess\tBT\tWT\tTAT")

for i in range(n):
    print(f"P{i+1}\t{bt[i]}\t{wt[i]}\t{tat[i]}")

avg_wt = sum(wt) / n
avg_tat = sum(tat) / n

print("\nAverage Waiting Time =", avg_wt)
print("Average Turnaround Time =", avg_tat)
